# Optional settings. SpecLens runs without any of them.
# Copy to .env only if you want to change a value, and export it in your shell.
# The app does not read .env files by itself and never needs a secret.

# Port for the local server (default 4173)
# PowerShell: $env:PORT=4300; npm start      macOS and Linux: PORT=4300 npm start
PORT=4173

# Address to listen on. Keep 127.0.0.1 so only this computer can reach it.
HOST=127.0.0.1

# Folder for the event log and the working copy of the app under test (default .speclens)
SPECLENS_DATA_DIR=.speclens
